# ──────────────────────────────────────────────────────────────────────────
#  iIrys Frame — environment
#  Copy to ".env" and fill in. NEVER commit ".env" (it is gitignored).
# ──────────────────────────────────────────────────────────────────────────

# EVM private key that pays for and signs uploads (the Irys "node" wallet).
# Without it, iIrys Frame runs in READ-ONLY mode: you can browse the vault and see
# price estimates, but cannot fund or upload. Format: 0x + 64 hex chars.
PRIVATE_KEY=

# Default network the dashboard opens on: "devnet" (free testnet tokens,
# ~60-day retention — use this to build/test) or "mainnet" (permanent, paid).
NETWORK=devnet

# Optional EVM RPC. Devnet pays with Sepolia ETH; mainnet uses Ethereum L1.
# Leave blank to use the SDK defaults.
EVM_RPC_URL=

# ── Safety rails ──────────────────────────────────────────────────────────
# Hard cap (in ETH) for a single /api/fund call. Prevents fat-finger funding.
FUND_MAX_ETH=0.1

# Optional shared secret. If set, write routes (fund/upload) require the
# header "x-vault-token: <value>". Leave blank for a single-user localhost box.
VAULT_TOKEN=

# ── Server ────────────────────────────────────────────────────────────────
PORT=1717
HOST=127.0.0.1

# ── Gateways / GraphQL (override only if Irys changes endpoints) ───────────
MAINNET_GATEWAY=https://gateway.irys.xyz
MAINNET_GRAPHQL=https://arweave.mainnet.irys.xyz/graphql
DEVNET_GATEWAY=https://gateway.irys.xyz
DEVNET_GRAPHQL=https://arweave.devnet.irys.xyz/graphql
