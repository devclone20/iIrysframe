{
  "name": "iirys-frame",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "iIrys Frame — control panel for the permanent NFT image bank on Irys (CLONE FRAME / iCLONE).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "serve": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.1",
    "@fastify/static": "^8.0.3",
    "@irys/upload": "^0.0.15",
    "@irys/upload-ethereum": "^0.0.15",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
