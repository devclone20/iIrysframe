# ── ICloneAgent deploy (Foundry) ─────────────────────────────────────────────
# Copy to .env. NEVER commit .env.

# Deployer key (funded with Base ETH for gas). 0x + 64 hex.
PRIVATE_KEY=

# RPCs
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Basescan API key (for --verify). https://basescan.org/myapikey
BASESCAN_API_KEY=

# ── Constructor params (sensible defaults applied if unset) ───────────────────
NFT_NAME=iCLONE Agent
NFT_SYMBOL=INFT
# Owner of the contract (admin). Defaults to the deployer.
NFT_OWNER=
# Treasury that receives the 5% royalty. Defaults to the deployer.
ROYALTY_RECEIVER=
# Royalty in basis points (500 = 5%).
ROYALTY_BPS=500
# ERC-6551 — canonical registry is identical on every chain; implementation is
# the Tokenbound account impl. Defaults applied in Deploy.s.sol; override here
# after verifying the current Base implementation.
ERC6551_REGISTRY=0x000000006551c19487814612e58FE06813775758
ERC6551_IMPLEMENTATION=0x41C8f39463A868d3A88af00cd0fe7102F30E44eC
