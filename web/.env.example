# ── iIrys Frame web (Privy auth) ──────────────────────────────────────────────────
# Create a free app at https://dashboard.privy.io → copy its App ID here.
# Without it, iIrys Frame runs in "setup" mode: the Studio works, but wallet login
# is disabled until you paste a valid App ID and restart `npm run dev`.
VITE_PRIVY_APP_ID=

# Optional: your deployed Base ERC-721 collection to enable the in-app Mint
# button. Leave blank to keep mint link-only (copy the tokenURI).
VITE_MINT_CONTRACT=
